NODE_ENV=development
PORT=3000
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:3001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_database_password
DB_NAME=mpwt_vehicle_inspection_renewal
DB_LOGGING=false

JWT_ACCESS_SECRET=<replace-with-a-long-random-secret>
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=<replace-with-a-different-long-random-secret>
JWT_REFRESH_EXPIRES_IN=7d

REFRESH_COOKIE_NAME=mpwt_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

VERIFICATION_CODE_TTL_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
EXPOSE_DEVELOPMENT_VERIFICATION_CODE=false

# Set to true only for a controlled first deployment. The existing admin is never overwritten.
ADMIN_BOOTSTRAP_ENABLED=false
# ADMIN_BOOTSTRAP_PHONE=<optional-cambodian-phone>
ADMIN_BOOTSTRAP_EMAIL=<replace-with-bootstrap-admin-email>
ADMIN_BOOTSTRAP_PASSWORD=<replace-with-a-strong-bootstrap-password>

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_pgadmin_password
