Project MPWT_Vehicle_Inspection_Renewal_Service {
  database_type: 'PostgreSQL'
  Note: 'Mock/local database for the internship MVP. Citizen and Admin are implemented; Staff is reserved for later.'
}

Enum user_role {
  CITIZEN
  ADMIN
  STAFF
}

Enum user_status {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

Enum vehicle_plate_category {
  PROVINCE
  PERSONALIZED_CAMBODIA
}

Enum verification_purpose {
  REGISTER_ACCOUNT
  RESET_PASSWORD
  CHANGE_PHONE
}

Enum application_status {
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  READY_FOR_INSPECTION
  INSPECTION_FAILED
  COMPLETED
  CANCELLED
}

Enum document_type {
  VEHICLE_REGISTRATION_CARD
  PREVIOUS_INSPECTION_CERTIFICATE
  NATIONAL_ID
}

Enum document_status {
  PENDING
  APPROVED
  REJECTED
}

Enum appointment_slot_status {
  OPEN
  CLOSED
  CANCELLED
}

Enum appointment_status {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

Enum payment_method {
  PAY_AT_STATION
  BANK_QR
  BANK_CARD
}

Enum payment_status {
  PENDING
  CONFIRMED
  FAILED
  REJECTED
}

Enum inspection_status {
  PENDING
  COMPLETED
}

Enum inspection_result {
  PASS
  FAIL
}

Enum sticker_status {
  NOT_READY
  READY_FOR_PICKUP
  ISSUED
}

Enum notification_channel {
  IN_APP
  EMAIL
  SMS
}

Enum notification_delivery_status {
  PENDING
  SENT
  FAILED
}

Enum notification_type {
  APPLICATION_SUBMITTED
  REVIEW_STARTED
  CORRECTION_REQUIRED
  DOCUMENTS_APPROVED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  APPOINTMENT_NO_SHOW
  READY_FOR_INSPECTION
  INSPECTION_PASSED
  INSPECTION_FAILED
  STICKER_READY
  APPLICATION_COMPLETED
  APPLICATION_CANCELLED
  SYSTEM_ANNOUNCEMENT
}

Enum timeline_event_type {
  APPLICATION_SUBMITTED
  REVIEW_STARTED
  CORRECTION_REQUIRED
  CORRECTION_RESUBMITTED
  DOCUMENTS_APPROVED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_NO_SHOW
  READY_FOR_INSPECTION
  INSPECTION_PASSED
  INSPECTION_FAILED
  STICKER_PREPARING
  STICKER_READY
  STICKER_ISSUED
  APPLICATION_COMPLETED
  APPLICATION_CANCELLED
}

Enum audit_actor_type {
  USER
  SYSTEM
}

Table users {
  id uuid [pk]

  role user_role [not null, default: 'CITIZEN']
  status user_status [not null, default: 'PENDING_VERIFICATION']

  phone varchar(20) [unique]
  email varchar(255) [unique]
  password_hash varchar(255) [not null]

  phone_verified_at timestamptz
  email_verified_at timestamptz
  last_login_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'NestJS validation: CITIZEN requires phone; ADMIN requires email. PostgreSQL migration should require phone OR email.'
}

Table citizen_profiles {
  id uuid [pk]

  user_id uuid [not null, unique]

  name_kh varchar(150) [not null]
  name_en varchar(150) [not null]
  national_id_number varchar(50) [unique]
  address text
  profile_image_key varchar(500)

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table verification_codes {
  id uuid [pk]

  user_id uuid
  destination varchar(255) [not null]
  purpose verification_purpose [not null]

  code_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  used_at timestamptz
  attempt_count int [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (destination, purpose, created_at)
  }

  Note: 'Store a hashed OTP, never the plain code. user_id may be null during account registration.'
}

Table refresh_sessions {
  id uuid [pk]

  user_id uuid [not null]
  token_hash varchar(255) [not null]

  expires_at timestamptz [not null]
  last_used_at timestamptz
  revoked_at timestamptz
  revocation_reason varchar(100)
  reuse_detected_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, expires_at) [name: 'idx_refresh_sessions_user_active']
    expires_at [name: 'idx_refresh_sessions_expires_at']
  }

  Note: 'Stores only a hidden refresh-token hash. The primary key supports signed session-ID lookup. idx_refresh_sessions_user_active is partial where revoked_at IS NULL; expiration cleanup uses idx_refresh_sessions_expires_at. User deletion cascades these security-credential rows. PostgreSQL checks require a nonblank hash, expiry after creation, all recorded moments not before creation, reuse detection only after revocation, and revoked_at/revocation_reason as a pair.'
}

Table vehicles {
  id uuid [pk]

  linked_citizen_id uuid

  registration_number varchar(50) [not null, unique]
  plate_number varchar(30) [not null]
  plate_category vehicle_plate_category [not null]
  plate_province varchar(100)
  plate_type varchar(50) [not null]

  vehicle_type varchar(50) [not null]
  make varchar(100) [not null]
  model varchar(100) [not null]
  manufacture_year smallint

  chassis_number varchar(100) [not null, unique]

  first_registration_date date [not null]
  last_inspection_date date
  inspection_expiry_date date [not null]

  registered_owner_name_kh varchar(150) [not null]
  registered_owner_name_en varchar(150) [not null]
  registered_owner_phone varchar(20) [not null]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'VALID, EXPIRING_SOON, EXPIRED, days remaining, and days expired are calculated from inspection_expiry_date. PROVINCE requires a non-null plate_province selected from the 25 canonical Khmer capital/province labels; plate_number uses 2A-3146 or 2AB-3146; PostgreSQL partial unique index uq_vehicles_province_plate_identity applies (plate_province, plate_number) only where plate_category = PROVINCE. plate_type is not part of PROVINCE identity: the same plate number may exist in different provinces, but may not be duplicated in the same province by changing plate_type. PERSONALIZED_CAMBODIA requires plate_province NULL; plate_number is nationally unique and plate_type does not affect identity; PostgreSQL partial unique index uq_vehicles_personalized_plate_number applies only where plate_category = PERSONALIZED_CAMBODIA. chk_vehicles_plate_province_category enforces the category/province consistency. កម្ពុជា is a derived API display label, never stored in plate_province. Partial indexes are documented here because DBML cannot safely model their WHERE predicates as unconditional unique indexes.'
}

Table renewal_applications {
  id uuid [pk]

  reference_number varchar(50) [not null, unique]

  citizen_id uuid [not null]
  vehicle_id uuid [not null]

  status application_status [not null, default: 'SUBMITTED']

  applicant_snapshot jsonb [not null]
  vehicle_snapshot jsonb [not null]

  current_correction_reason text

  submitted_at timestamptz [not null, default: `now()`]
  review_started_at timestamptz
  ready_for_inspection_at timestamptz
  completed_at timestamptz

  cancelled_at timestamptz
  cancelled_by_user_id uuid
  cancellation_reason text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (citizen_id, submitted_at)
    (vehicle_id, submitted_at)
    status
  }

  Note: 'PostgreSQL migration must enforce one active application per vehicle using a partial unique index.'
}

Table application_documents {
  id uuid [pk]

  application_id uuid [not null]
  document_type document_type [not null]

  version_number int [not null, default: 1]
  is_current boolean [not null, default: true]
  replaces_document_id uuid

  uploaded_by_user_id uuid [not null]

  storage_key varchar(500) [not null]
  original_file_name varchar(255) [not null]
  mime_type varchar(100) [not null]
  file_size_bytes bigint [not null]

  status document_status [not null, default: 'PENDING']

  reviewed_by_user_id uuid
  reviewed_at timestamptz
  rejection_reason text

  uploaded_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, document_type, version_number) [unique]
    (application_id, status)
  }

  Note: 'PostgreSQL migration must enforce one current document per application and document type using a partial unique index where is_current = true.'
}

Table inspection_stations {
  id uuid [pk]

  code varchar(30) [not null, unique]
  name_kh varchar(200) [not null]
  name_en varchar(200) [not null]

  province varchar(100) [not null]
  address text [not null]
  phone varchar(20)

  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table appointment_slots {
  id uuid [pk]

  station_id uuid [not null]

  slot_date date [not null]
  start_time time [not null]
  end_time time [not null]

  capacity smallint [not null, default: 1]
  status appointment_slot_status [not null, default: 'OPEN']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (station_id, slot_date, start_time, end_time) [unique]
    (station_id, slot_date, status)
  }

  Note: 'Backend must check capacity again inside a database transaction before creating an appointment.'
}

Table appointments {
  id uuid [pk]

  application_id uuid [not null]
  slot_id uuid [not null]

  status appointment_status [not null, default: 'SCHEDULED']

  booked_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  cancelled_at timestamptz
  cancelled_by_user_id uuid
  cancellation_reason text

  no_show_marked_at timestamptz
  no_show_marked_by_user_id uuid

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, application_id) [unique]
    (application_id, status)
    (slot_id, status)
  }

  Note: 'PostgreSQL migration must enforce one SCHEDULED appointment per application using a partial unique index. The composite (id, application_id) key allows the inspection foreign key to guarantee that the appointment belongs to the same application.'
}

Table payments {
  id uuid [pk]

  application_id uuid [not null, unique]

  invoice_number varchar(50) [not null, unique]
  receipt_number varchar(50) [unique]

  method payment_method [not null]
  status payment_status [not null, default: 'PENDING']

  base_amount numeric(12,2) [not null]
  late_fee numeric(12,2) [not null, default: 0]
  total_amount numeric(12,2) [not null]
  currency char(3) [not null, default: 'KHR']

  payment_reference varchar(100)

  provider_name varchar(100)
  provider_transaction_id varchar(150)

  confirmed_by_user_id uuid
  confirmed_at timestamptz

  failed_at timestamptz
  failure_reason text

  rejected_at timestamptz
  rejected_by_user_id uuid
  rejection_reason text

  invoice_issued_at timestamptz [not null, default: `now()`]
  invoice_file_key varchar(500)
  receipt_file_key varchar(500)

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    status
    method
    (provider_name, provider_transaction_id) [unique]
  }

  Note: 'For PAY_AT_STATION, PENDING means waiting to collect payment. CONFIRMED requires confirmed_at and confirmed_by_user_id. If provider_transaction_id is present, provider_name is required.'
}

Table inspections {
  id uuid [pk]

  application_id uuid [not null]
  appointment_id uuid [not null, unique]

  status inspection_status [not null, default: 'PENDING']
  result inspection_result

  recorded_by_user_id uuid

  started_at timestamptz
  completed_at timestamptz

  failure_reason text
  notes text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at)
    status
    result
  }

  Note: 'If result = FAIL, failure_reason is required. Reinspection is reserved for later, so multiple inspections per application are allowed.'
}

Table stickers {
  id uuid [pk]

  application_id uuid [not null, unique]

  status sticker_status [not null, default: 'NOT_READY']

  sticker_number varchar(100) [unique]
  certificate_number varchar(100) [unique]
  certificate_file_key varchar(500)

  ready_at timestamptz
  marked_ready_by_user_id uuid

  issued_at timestamptz
  issued_by_user_id uuid

  pickup_recipient_name varchar(150)
  pickup_notes text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    status
  }

  Note: 'Application becomes COMPLETED only when the inspection result is PASS and sticker status is ISSUED.'
}

Table notifications {
  id uuid [pk]

  recipient_user_id uuid [not null]
  application_id uuid

  type notification_type [not null]
  channel notification_channel [not null, default: 'IN_APP']
  delivery_status notification_delivery_status [not null, default: 'SENT']

  title varchar(255) [not null]
  message text [not null]
  data jsonb

  created_by_user_id uuid

  sent_at timestamptz
  failed_at timestamptz
  failure_reason text

  is_read boolean [not null, default: false]
  read_at timestamptz

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (recipient_user_id, is_read, created_at)
    (application_id, created_at)
  }

  Note: 'Only IN_APP is implemented in the MVP. EMAIL and SMS are reserved for later.'
}

Table application_timeline_events {
  id uuid [pk]

  application_id uuid [not null]
  event_type timeline_event_type [not null]

  title varchar(255) [not null]
  message text

  actor_user_id uuid
  visible_to_citizen boolean [not null, default: true]

  metadata jsonb

  occurred_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, occurred_at)
    (application_id, visible_to_citizen, occurred_at)
  }
}

Table audit_logs {
  id uuid [pk]

  actor_type audit_actor_type [not null]
  actor_user_id uuid

  application_id uuid

  action varchar(100) [not null]
  entity_type varchar(100) [not null]
  entity_id uuid

  description text

  old_values jsonb
  new_values jsonb

  ip_address inet
  user_agent text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at)
    (entity_type, entity_id, created_at)
    (actor_user_id, created_at)
  }

  Note: 'Audit logs are immutable and are not visible to citizens.'
}


// Relationships

Ref: citizen_profiles.user_id - users.id

Ref: verification_codes.user_id > users.id
Ref: refresh_sessions.user_id > users.id [delete: cascade]

Ref: vehicles.linked_citizen_id > users.id

Ref: renewal_applications.citizen_id > users.id
Ref: renewal_applications.vehicle_id > vehicles.id
Ref: renewal_applications.cancelled_by_user_id > users.id

Ref: application_documents.application_id > renewal_applications.id
Ref: application_documents.uploaded_by_user_id > users.id
Ref: application_documents.reviewed_by_user_id > users.id
Ref: application_documents.replaces_document_id > application_documents.id

Ref: appointment_slots.station_id > inspection_stations.id

Ref: appointments.application_id > renewal_applications.id
Ref: appointments.slot_id > appointment_slots.id
Ref: appointments.cancelled_by_user_id > users.id
Ref: appointments.no_show_marked_by_user_id > users.id

Ref: payments.application_id - renewal_applications.id
Ref: payments.confirmed_by_user_id > users.id
Ref: payments.rejected_by_user_id > users.id

Ref: inspections.application_id > renewal_applications.id
Ref: inspections.(appointment_id, application_id) > appointments.(id, application_id)
Ref: inspections.recorded_by_user_id > users.id

Ref: stickers.application_id - renewal_applications.id
Ref: stickers.marked_ready_by_user_id > users.id
Ref: stickers.issued_by_user_id > users.id

Ref: notifications.recipient_user_id > users.id
Ref: notifications.application_id > renewal_applications.id
Ref: notifications.created_by_user_id > users.id

Ref: application_timeline_events.application_id > renewal_applications.id
Ref: application_timeline_events.actor_user_id > users.id

Ref: audit_logs.actor_user_id > users.id
Ref: audit_logs.application_id > renewal_applications.id


// PostgreSQL migration-only constraints that DBML cannot fully express:
//
// 1. CHECK (phone IS NOT NULL OR email IS NOT NULL) on users.
//
// 2. Partial unique index: one active renewal application per vehicle where
//    status IN ('SUBMITTED', 'UNDER_REVIEW', 'CORRECTION_REQUIRED', 'READY_FOR_INSPECTION').
//
// 3. Partial unique index: one current application document for each
//    (application_id, document_type) WHERE is_current = true.
//
// 4. Partial unique index: one SCHEDULED appointment per application.
//
// 5. CHECK appointment_slots.capacity > 0.
//
// 6. CHECK appointment_slots.end_time > appointment_slots.start_time.
//
// 7. CHECK application_documents.version_number > 0.
//
// 8. CHECK application_documents.file_size_bytes > 0.
//
// 9. CHECK payments.base_amount >= 0, late_fee >= 0, and total_amount >= 0.
//
// 10. Unique provider transaction rule:
//     CREATE UNIQUE INDEX unique_provider_transaction
//     ON payments (provider_name, provider_transaction_id)
//     WHERE provider_transaction_id IS NOT NULL;
//
// 11. Inspection/appointment consistency:
//     appointments must have UNIQUE (id, application_id), and inspections must use
//     FOREIGN KEY (appointment_id, application_id)
//     REFERENCES appointments (id, application_id).
//
// 12. Refresh sessions:
//     - token_hash must not be blank.
//     - expires_at must be after created_at.
//     - last_used_at, revoked_at, and reuse_detected_at, when present, must not
//       be before created_at.
//     - reuse_detected_at requires revoked_at.
//     - revoked_at and revocation_reason are present together or absent together.
//     - the active-user index is partial: (user_id, expires_at) WHERE revoked_at IS NULL.
//
// 13. NestJS service validation:
//     - CORRECTION_REQUIRED requires current_correction_reason.
//     - CANCELLED application requires cancellation fields.
//     - REJECTED document requires rejection_reason.
//     - CANCELLED appointment requires cancellation fields.
//     - NO_SHOW appointment requires no-show fields.
//     - CONFIRMED payment requires confirmation fields.
//     - FAILED payment requires failure fields.
//     - REJECTED payment requires rejection fields.
//     - COMPLETED inspection requires result, completed_at, and recorded_by_user_id.
//     - FAIL inspection requires failure_reason.
//     - READY_FOR_PICKUP and ISSUED sticker states require their corresponding fields.
//     - COMPLETED application requires PASS inspection and ISSUED sticker.
