Project MPWT_Vehicle_Inspection_Renewal_Service {
  database_type: 'PostgreSQL'
  Note: 'Current executed PostgreSQL schema for the internship MVP. TypeORM migrations 1-8 are the executable source of truth. Deferred design is noted separately and is not represented as live schema.'
}

// CURRENT EXECUTED SCHEMA is TypeORM migrations 1-8. Deferred design is noted
// separately and is not represented as a table, column, enum, index, or Ref. In particular, migration
// 6 created vehicle_class/category/history, migration 7 created the current
// application lifecycle/status-history/documents schema, and migration 8 added
// renewal_applications.current_rejection_reason with its trimmed 1–500 check.

Enum user_role {
  CITIZEN
  ADMIN
  STAFF
}

Enum user_status {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

Enum vehicle_plate_category {
  PROVINCE
  PERSONALIZED_CAMBODIA
}

Enum vehicle_class {
  LIGHT
  HEAVY
}

Enum verification_purpose {
  REGISTER_ACCOUNT
  RESET_PASSWORD
  CHANGE_PHONE
}

Enum application_status {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  APPOINTMENT_SELECTION_REQUIRED
  APPROVED
  REJECTED
  REINSPECTION_REQUIRED
  CANCELLED
  COMPLETED
}

Enum document_type {
  VEHICLE_REGISTRATION_CARD
  PREVIOUS_INSPECTION_CERTIFICATE
  CITIZEN_ID_CARD
}

Enum document_status {
  PENDING
  APPROVED
  REJECTED
}

Enum appointment_slot_status {
  OPEN
  CLOSED
  CANCELLED
}

Enum appointment_status {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

Enum payment_method {
  PAY_AT_STATION
  BANK_QR
  BANK_CARD
}

Enum payment_status {
  PENDING
  CONFIRMED
  FAILED
  REJECTED
}

Enum inspection_status {
  PENDING
  COMPLETED
}

Enum inspection_result {
  PASS
  FAIL
}

Enum sticker_status {
  NOT_READY
  READY_FOR_PICKUP
  ISSUED
}

Enum notification_channel {
  IN_APP
  EMAIL
  SMS
}

Enum notification_delivery_status {
  PENDING
  SENT
  FAILED
}

Enum notification_type {
  APPLICATION_SUBMITTED
  REVIEW_STARTED
  CORRECTION_REQUIRED
  DOCUMENTS_APPROVED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  APPOINTMENT_NO_SHOW
  READY_FOR_INSPECTION
  INSPECTION_PASSED
  INSPECTION_FAILED
  STICKER_READY
  APPLICATION_COMPLETED
  APPLICATION_CANCELLED
  SYSTEM_ANNOUNCEMENT
}

Enum timeline_event_type {
  APPLICATION_SUBMITTED
  REVIEW_STARTED
  CORRECTION_REQUIRED
  CORRECTION_RESUBMITTED
  DOCUMENTS_APPROVED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_NO_SHOW
  READY_FOR_INSPECTION
  INSPECTION_PASSED
  INSPECTION_FAILED
  STICKER_PREPARING
  STICKER_READY
  STICKER_ISSUED
  APPLICATION_COMPLETED
  APPLICATION_CANCELLED
}

Enum audit_actor_type {
  USER
  SYSTEM
}

Table users {
  id uuid [pk]
  role user_role [not null, default: 'CITIZEN']
  status user_status [not null, default: 'PENDING_VERIFICATION']
  phone varchar(20) [unique]
  email varchar(255) [unique]
  password_hash varchar(255) [not null]
  phone_verified_at timestamptz
  email_verified_at timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'NestJS validation: CITIZEN requires phone; ADMIN requires email. PostgreSQL migration should require phone OR email. Active ADMIN accounts control classification, financial decisions, and workflow actions.'
}

Table citizen_profiles {
  id uuid [pk]
  user_id uuid [not null, unique]
  name_kh varchar(150) [not null]
  name_en varchar(150) [not null]
  national_id_number varchar(50) [unique]
  address text
  profile_image_key varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table verification_codes {
  id uuid [pk]
  user_id uuid
  destination varchar(255) [not null]
  purpose verification_purpose [not null]
  code_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  used_at timestamptz
  attempt_count int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (destination, purpose, created_at)
  }

  Note: 'Store a hashed OTP, never the plain code. user_id may be null during account registration.'
}

Table refresh_sessions {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  last_used_at timestamptz
  revoked_at timestamptz
  revocation_reason varchar(100)
  reuse_detected_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, expires_at) [name: 'idx_refresh_sessions_user_active']
    expires_at [name: 'idx_refresh_sessions_expires_at']
  }

  Note: 'Stores only a hidden refresh-token hash. The primary key supports signed session-ID lookup. idx_refresh_sessions_user_active is partial where revoked_at IS NULL; expiration cleanup uses idx_refresh_sessions_expires_at. User deletion cascades these security-credential rows. PostgreSQL checks require a nonblank hash, expiry after creation, all recorded moments not before creation, reuse detection only after revocation, and revoked_at/revocation_reason as a pair.'
}

Table inspection_vehicle_categories {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name_kh varchar(200) [not null]
  name_en varchar(200)
  vehicle_class vehicle_class [not null]
  validity_months smallint [not null]
  inspection_fee_khr numeric(12,2) [not null]
  service_fee_khr numeric(12,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, vehicle_class) [unique, name: 'uq_inspection_vehicle_categories_id_class']
    (vehicle_class, is_active) [name: 'idx_inspection_vehicle_categories_class_active']
  }

  Note: 'CURRENT EXECUTED SCHEMA (migration 6). No category records are seeded. code and vehicle_class immutability and inactive-category assignment are application rules; constraints include uq_inspection_vehicle_categories_code, uq_inspection_vehicle_categories_id_class, chk_vehicle_categories_code_not_blank, chk_vehicle_categories_name_kh_not_blank, chk_vehicle_categories_validity_positive, chk_vehicle_categories_inspection_fee_nonnegative, and chk_vehicle_categories_service_fee_nonnegative.'
}

Table vehicles {
  id uuid [pk]
  linked_citizen_id uuid
  registration_number varchar(50) [not null, unique]
  plate_number varchar(30) [not null]
  plate_category vehicle_plate_category [not null]
  plate_province varchar(100)
  plate_type varchar(50) [not null]
  vehicle_type varchar(50) [not null]
  vehicle_class vehicle_class
  inspection_category_id uuid
  classification_verified_at timestamptz
  classification_verified_by uuid
  make varchar(100) [not null]
  model varchar(100) [not null]
  manufacture_year smallint
  chassis_number varchar(100) [not null, unique]
  first_registration_date date [not null]
  last_inspection_date date
  inspection_expiry_date date [not null]
  registered_owner_name_kh varchar(150) [not null]
  registered_owner_name_en varchar(150) [not null]
  registered_owner_phone varchar(20) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (inspection_category_id, vehicle_class) [name: 'idx_vehicles_inspection_category_class']
  }

  Note: 'CURRENT EXECUTED SCHEMA. VALID, EXPIRING_SOON, EXPIRED, days remaining, and days expired are calculated from inspection_expiry_date. PROVINCE requires a non-null plate_province; PERSONALIZED_CAMBODIA requires plate_province NULL. vehicle_type remains the descriptive field and is not the official class. Migration 6 permits legacy vehicles with all four classification fields NULL, or requires vehicle_class, inspection_category_id, classification_verified_at, and classification_verified_by all populated. Citizens cannot control classification or verification fields.'
}

Table vehicle_classification_history {
  id uuid [pk]
  vehicle_id uuid [not null]
  previous_vehicle_class vehicle_class
  new_vehicle_class vehicle_class [not null]
  previous_inspection_category_id uuid
  new_inspection_category_id uuid [not null]
  changed_by_admin_id uuid [not null]
  reason text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (vehicle_id, created_at, id) [name: 'idx_vehicle_classification_history_vehicle_created']
  }

  Note: 'CURRENT EXECUTED SCHEMA (migration 6). First assignment uses NULL previous values. chk_vehicle_class_history_previous_pair and chk_vehicle_class_history_reason_not_blank enforce pair/reason shape. Rows are immutable through fn_guard_vehicle_classification_history and trg_guard_vehicle_classification_history; ordering is (created_at, id).'
}

Table renewal_applications {
  id uuid [pk]
  reference_number varchar(50) [unique]
  citizen_id uuid [not null]
  vehicle_id uuid [not null]
  status application_status [not null, default: 'DRAFT']
  applicant_snapshot jsonb
  vehicle_snapshot jsonb
  current_correction_reason text
  current_rejection_reason text
  submitted_at timestamptz
  review_started_at timestamptz
  ready_for_inspection_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  cancelled_by_user_id uuid
  cancellation_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (citizen_id, submitted_at) [name: 'idx_renewal_applications_citizen_submitted_at']
    (vehicle_id, submitted_at) [name: 'idx_renewal_applications_vehicle_submitted_at']
    status [name: 'idx_renewal_applications_status']
  }

  Note: 'CURRENT EXECUTED SCHEMA (migrations 7–8). reference_number, applicant_snapshot, vehicle_snapshot, and submitted_at are nullable for drafts. current_rejection_reason has chk_renewal_applications_current_rejection_reason: NULL or char_length(btrim(...)) BETWEEN 1 AND 500. uq_unfinished_application_per_vehicle covers DRAFT, SUBMITTED, UNDER_REVIEW, CORRECTION_REQUIRED, APPOINTMENT_SELECTION_REQUIRED, APPROVED, and REINSPECTION_REQUIRED. Current workflow includes DRAFT→SUBMITTED, SUBMITTED→UNDER_REVIEW, UNDER_REVIEW→CORRECTION_REQUIRED or REJECTED, and REJECTED→UNDER_REVIEW. Correction/rejection/reopen reasons are application workflow/audit concerns; audit_logs records APPLICATION_REJECTED and APPLICATION_REOPENED. DEFERRED/FUTURE DESIGN: preferred inspection station/date and capacity orchestration are not columns of this executed table.'
}

Table renewal_application_status_history {
  id uuid [pk]
  application_id uuid [not null]
  previous_status application_status
  new_status application_status [not null]
  changed_by_user_id uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at, id) [name: 'idx_renewal_application_status_history_application_created']
  }

  Note: 'CURRENT EXECUTED SCHEMA (migration 7). previous_status may be NULL only for the initial DRAFT row; otherwise it differs from new_status (chk_renewal_application_status_history_transition). Rows are immutable through public.fn_guard_renewal_application_status_history and trg_guard_renewal_application_status_history_immutable. Reasons and metadata are not columns on this table.'
}

Table application_documents {
  id uuid [pk]
  application_id uuid [not null]
  document_type document_type [not null]
  version_number int [not null, default: 1]
  is_current boolean [not null, default: true]
  replaces_document_id uuid
  uploaded_by_user_id uuid [not null]
  storage_key varchar(500) [not null]
  original_file_name varchar(255) [not null]
  mime_type varchar(100) [not null]
  file_size_bytes bigint [not null]
  status document_status [not null, default: 'PENDING']
  reviewed_by_user_id uuid
  reviewed_at timestamptz
  rejection_reason text
  uploaded_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, document_type, version_number) [unique, name: 'uq_application_documents_application_document_type_version']
    (application_id, status) [name: 'idx_application_documents_application_status']
  }

  Note: 'CURRENT EXECUTED SCHEMA. document_type includes VEHICLE_REGISTRATION_CARD, PREVIOUS_INSPECTION_CERTIFICATE, and CITIZEN_ID_CARD (migration 7 renamed NATIONAL_ID). uq_current_document_per_type permits one current row per application/type; uq_application_documents_application_document_type_version preserves version history. chk_application_documents_file_size_max_5mb enforces the 5 MB limit. PDF/JPG/JPEG/PNG acceptance remains application validation.'
}

Table inspection_stations {
  id uuid [pk]
  code varchar(30) [not null, unique]
  name_kh varchar(200) [not null]
  name_en varchar(200) [not null]
  province varchar(100) [not null]
  address text [not null]
  phone varchar(20)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'CURRENT EXECUTED SCHEMA. Daily-capacity orchestration is deferred and has no live column or table in migrations 1-8.'
}

Table appointment_slots {
  id uuid [pk]
  station_id uuid [not null]
  slot_date date [not null]
  start_time time [not null]
  end_time time [not null]
  capacity smallint [not null, default: 1]
  status appointment_slot_status [not null, default: 'OPEN']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (station_id, slot_date, start_time, end_time) [unique, name: 'uq_appointment_slots_station_date_start_end']
    (station_id, slot_date, status) [name: 'idx_appointment_slots_station_date_status']
  }

  Note: 'EXISTING EXECUTED SCHEMA — backend must check capacity again inside a database transaction before creating an appointment. TRANSITIONAL COMPATIBILITY — the approved v1 workflow uses daily capacity, not new hourly reservations. Do not delete or retire this table until no active workflow depends on it.'
}

Table appointments {
  id uuid [pk]
  application_id uuid [not null]
  slot_id uuid [not null]
  status appointment_status [not null, default: 'SCHEDULED']
  booked_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  cancelled_at timestamptz
  cancelled_by_user_id uuid
  cancellation_reason text
  no_show_marked_at timestamptz
  no_show_marked_by_user_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, application_id) [unique, name: 'uq_appointments_id_application']
    (application_id, status) [name: 'idx_appointments_application_status']
    (slot_id, status) [name: 'idx_appointments_slot_status']
  }

  Note: 'CURRENT EXECUTED SCHEMA. appointment_status retains SCHEDULED; daily-capacity appointment design is deferred.'
}

Table payments {
  id uuid [pk]
  application_id uuid [not null, unique]
  invoice_number varchar(50) [not null, unique]
  receipt_number varchar(50) [unique]
  method payment_method [not null]
  status payment_status [not null, default: 'PENDING']
  base_amount numeric(12,2) [not null]
  late_fee numeric(12,2) [not null, default: 0]
  total_amount numeric(12,2) [not null]
  currency char(3) [not null, default: 'KHR']
  payment_reference varchar(100)
  provider_name varchar(100)
  provider_transaction_id varchar(150)
  confirmed_by_user_id uuid
  confirmed_at timestamptz
  failed_at timestamptz
  failure_reason text
  rejected_at timestamptz
  rejected_by_user_id uuid
  rejection_reason text
  invoice_issued_at timestamptz [not null, default: `now()`]
  invoice_file_key varchar(500)
  receipt_file_key varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    status [name: 'idx_payments_status']
    method [name: 'idx_payments_method']
    (provider_name, provider_transaction_id) [unique]
  }

  Note: 'CURRENT EXECUTED SCHEMA. Payments retains its legacy invoice and receipt fields; renewal_invoices and payment_receipts are deferred and are not live tables.'
}

Table inspections {
  id uuid [pk]
  application_id uuid [not null]
  appointment_id uuid [not null, unique]
  status inspection_status [not null, default: 'PENDING']
  result inspection_result
  recorded_by_user_id uuid
  started_at timestamptz
  completed_at timestamptz
  failure_reason text
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at) [name: 'idx_inspections_application_created']
    status [name: 'idx_inspections_status']
    result [name: 'idx_inspections_result']
  }

  Note: 'EXISTING EXECUTED SCHEMA — If result = FAIL, failure_reason is required. Reinspection is reserved for later, so multiple inspections per application are allowed. TARGET DESIGN — NOT YET MIGRATED: reused as physical inspection attempts, one appointment has zero or one inspection, PASS may complete the renewal, and FAIL creates REINSPECTION_REQUIRED without updating vehicle expiry.'
}

Table stickers {
  id uuid [pk]
  application_id uuid [not null, unique]
  status sticker_status [not null, default: 'NOT_READY']
  sticker_number varchar(100) [unique]
  certificate_number varchar(100) [unique]
  certificate_file_key varchar(500)
  ready_at timestamptz
  marked_ready_by_user_id uuid
  issued_at timestamptz
  issued_by_user_id uuid
  pickup_recipient_name varchar(150)
  pickup_notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    status
  }

  Note: 'Application becomes COMPLETED only when the inspection result is PASS and sticker status is ISSUED.'
}

Table notifications {
  id uuid [pk]
  recipient_user_id uuid [not null]
  application_id uuid
  type notification_type [not null]
  channel notification_channel [not null, default: 'IN_APP']
  delivery_status notification_delivery_status [not null, default: 'SENT']
  title varchar(255) [not null]
  message text [not null]
  data jsonb
  created_by_user_id uuid
  sent_at timestamptz
  failed_at timestamptz
  failure_reason text
  is_read boolean [not null, default: false]
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (recipient_user_id, is_read, created_at) [name: 'idx_notifications_recipient_read_created']
    (application_id, created_at) [name: 'idx_notifications_application_created']
  }

  Note: 'EXISTING EXECUTED SCHEMA — only IN_APP is implemented in the MVP; EMAIL and SMS are reserved for later. MIGRATION DECISION REQUIRED — a later approved migration needs vocabulary for CORRECTION_REQUESTED, APPOINTMENT_SELECTION_REQUIRED, APPLICATION_APPROVED, APPLICATION_REJECTED, REINSPECTION_REQUIRED, and APPROVAL_REVERSED. Do not finalize mappings between current and future values. Dedicated status/classification tables remain authoritative immutable histories.'
}

Table application_timeline_events {
  id uuid [pk]
  application_id uuid [not null]
  event_type timeline_event_type [not null]
  title varchar(255) [not null]
  message text
  actor_user_id uuid
  visible_to_citizen boolean [not null, default: true]
  metadata jsonb
  occurred_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, occurred_at) [name: 'idx_timeline_application_occurred']
    (application_id, visible_to_citizen, occurred_at) [name: 'idx_timeline_application_visible_occurred']
  }

  Note: 'EXISTING citizen-facing timeline. MIGRATION DECISION REQUIRED — future application workflow vocabulary must be added/mapped only during the workflow implementation phase; enum mapping is deferred. renewal_application_status_history remains the authoritative target status history.'
}

Table audit_logs {
  id uuid [pk]
  actor_type audit_actor_type [not null]
  actor_user_id uuid
  application_id uuid
  action varchar(100) [not null]
  entity_type varchar(100) [not null]
  entity_id uuid
  description text
  old_values jsonb
  new_values jsonb
  ip_address inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at) [name: 'idx_audit_logs_application_created']
    (entity_type, entity_id, created_at) [name: 'idx_audit_logs_entity_created']
    (actor_user_id, created_at) [name: 'idx_audit_logs_actor_created']
  }

  Note: 'EXISTING EXECUTED SCHEMA — audit logs are immutable and are not visible to citizens. This generic audit log is reused but is not a replacement for dedicated immutable status or classification history.'
}

// Relationships. Historical, financial, and workflow references use RESTRICT unless a prior approved SET NULL behavior is explicitly retained.
Ref: citizen_profiles.user_id - users.id
Ref: verification_codes.user_id > users.id
Ref: refresh_sessions.user_id > users.id [delete: cascade]
Ref: vehicles.linked_citizen_id > users.id [delete: set null]
Ref: vehicles.(inspection_category_id, vehicle_class) > inspection_vehicle_categories.(id, vehicle_class) [delete: restrict]
Ref: vehicles.classification_verified_by > users.id [delete: restrict]
Ref: vehicle_classification_history.vehicle_id > vehicles.id [delete: restrict]
Ref: vehicle_classification_history.(previous_inspection_category_id, previous_vehicle_class) > inspection_vehicle_categories.(id, vehicle_class) [delete: restrict]
Ref: vehicle_classification_history.(new_inspection_category_id, new_vehicle_class) > inspection_vehicle_categories.(id, vehicle_class) [delete: restrict]
Ref: vehicle_classification_history.changed_by_admin_id > users.id [delete: restrict]
Ref: renewal_applications.citizen_id > users.id [delete: restrict]
Ref: renewal_applications.vehicle_id > vehicles.id [delete: restrict]
Ref: renewal_applications.cancelled_by_user_id > users.id [delete: set null]
Ref: renewal_application_status_history.application_id > renewal_applications.id [delete: restrict]
Ref: renewal_application_status_history.changed_by_user_id > users.id [delete: restrict]
Ref: application_documents.application_id > renewal_applications.id [delete: restrict]
Ref: application_documents.uploaded_by_user_id > users.id [delete: restrict]
Ref: application_documents.reviewed_by_user_id > users.id [delete: set null]
Ref: application_documents.replaces_document_id > application_documents.id [delete: restrict]
Ref: appointment_slots.station_id > inspection_stations.id [delete: restrict]
Ref: appointments.application_id > renewal_applications.id [delete: restrict]
Ref: appointments.slot_id > appointment_slots.id [delete: restrict]
Ref: appointments.cancelled_by_user_id > users.id [delete: set null]
Ref: appointments.no_show_marked_by_user_id > users.id [delete: set null]
Ref: payments.application_id - renewal_applications.id
Ref: payments.confirmed_by_user_id > users.id [delete: set null]
Ref: payments.rejected_by_user_id > users.id [delete: set null]
Ref: inspections.application_id > renewal_applications.id [delete: restrict]
Ref: inspections.(appointment_id, application_id) > appointments.(id, application_id) [delete: restrict]
Ref: inspections.recorded_by_user_id > users.id [delete: set null]
