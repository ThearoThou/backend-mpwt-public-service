Project MPWT_Vehicle_Inspection_Renewal_Service {
  database_type: 'PostgreSQL'
  Note: 'Cumulative current executed PostgreSQL schema after TypeORM migrations 1-12. The migrations are the executable source of truth.'
}

Enum user_role {
  CITIZEN
  ADMIN
  STAFF
}

Enum user_status {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

Enum vehicle_plate_category {
  PROVINCE
  PERSONALIZED_CAMBODIA
}

Enum vehicle_class {
  LIGHT
  HEAVY
}

Enum verification_purpose {
  REGISTER_ACCOUNT
  RESET_PASSWORD
  CHANGE_PHONE
}

Enum application_status {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  APPOINTMENT_SELECTION_REQUIRED
  APPROVED
  REJECTED
  REINSPECTION_REQUIRED
  INSPECTION_FAILED
  CANCELLED
  COMPLETED
}

Enum document_type {
  VEHICLE_REGISTRATION_CARD
  PREVIOUS_INSPECTION_CERTIFICATE
  CITIZEN_ID_CARD
}

Enum document_status {
  PENDING
  APPROVED
  REJECTED
}

Enum appointment_slot_status {
  OPEN
  CLOSED
  CANCELLED
}

Enum appointment_status {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

Enum inspection_status {
  PENDING
  COMPLETED
}

Enum inspection_result {
  PASS
  FAIL
}

Enum payment_method {
  PAY_AT_STATION
  BANK_QR
  BANK_CARD
}

Enum payment_status {
  PENDING
  CONFIRMED
  FAILED
  REJECTED
}

Enum notification_type {
  APPLICATION_SUBMITTED
  REVIEW_STARTED
  CORRECTION_REQUIRED
  DOCUMENTS_APPROVED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  APPOINTMENT_NO_SHOW
  READY_FOR_INSPECTION
  INSPECTION_PASSED
  INSPECTION_FAILED
  STICKER_READY
  APPLICATION_COMPLETED
  APPLICATION_CANCELLED
  SYSTEM_ANNOUNCEMENT
}

Enum notification_channel {
  IN_APP
  EMAIL
  SMS
}

Enum notification_delivery_status {
  PENDING
  SENT
  FAILED
}

Enum timeline_event_type {
  APPLICATION_SUBMITTED
  REVIEW_STARTED
  CORRECTION_REQUIRED
  CORRECTION_RESUBMITTED
  DOCUMENTS_APPROVED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_NO_SHOW
  READY_FOR_INSPECTION
  INSPECTION_PASSED
  INSPECTION_FAILED
  STICKER_PREPARING
  STICKER_READY
  STICKER_ISSUED
  APPLICATION_COMPLETED
  APPLICATION_CANCELLED
}

Enum audit_actor_type {
  USER
  SYSTEM
}

Table users {
  id uuid [pk]
  role user_role [not null, default: 'CITIZEN']
  status user_status [not null, default: 'PENDING_VERIFICATION']
  phone varchar(20) [unique]
  email varchar(255) [unique]
  password_hash varchar(255) [not null]
  phone_verified_at timestamptz
  email_verified_at timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'chk_users_phone_or_email requires phone IS NOT NULL OR email IS NOT NULL.'
}

Table citizen_profiles {
  id uuid [pk]
  user_id uuid [not null, unique]
  name_kh varchar(150) [not null]
  name_en varchar(150) [not null]
  national_id_number varchar(50) [unique]
  address text
  profile_image_key varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table verification_codes {
  id uuid [pk]
  user_id uuid
  destination varchar(255) [not null]
  purpose verification_purpose [not null]
  code_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  used_at timestamptz
  attempt_count int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (destination, purpose, created_at) [name: 'IDX_e2aa1f0c94500d4aa891eaf32f']
  }
}

Table refresh_sessions {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  last_used_at timestamptz
  revoked_at timestamptz
  revocation_reason varchar(100)
  reuse_detected_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, expires_at) [name: 'idx_refresh_sessions_user_active']
    expires_at [name: 'idx_refresh_sessions_expires_at']
  }

  Note: 'idx_refresh_sessions_user_active is partial where revoked_at IS NULL. Checks are chk_refresh_sessions_token_hash_not_blank, chk_refresh_sessions_expires_after_created, chk_refresh_sessions_last_used_after_created, chk_refresh_sessions_revoked_after_created, chk_refresh_sessions_reuse_detected_after_created, chk_refresh_sessions_reuse_requires_revocation, and chk_refresh_sessions_revocation_reason_pair.'
}

Table inspection_vehicle_categories {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name_kh varchar(200) [not null]
  name_en varchar(200)
  vehicle_class vehicle_class [not null]
  validity_months smallint [not null]
  inspection_fee_khr numeric(12,2) [not null]
  service_fee_khr numeric(12,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, vehicle_class) [unique, name: 'uq_inspection_vehicle_categories_id_class']
    (vehicle_class, is_active) [name: 'idx_inspection_vehicle_categories_class_active']
  }

  Note: 'Checks: chk_vehicle_categories_code_not_blank, chk_vehicle_categories_name_kh_not_blank, chk_vehicle_categories_validity_positive, chk_vehicle_categories_inspection_fee_nonnegative, and chk_vehicle_categories_service_fee_nonnegative.'
}

Table vehicles {
  id uuid [pk]
  linked_citizen_id uuid
  registration_number varchar(50) [not null, unique]
  plate_number varchar(30) [not null]
  plate_category vehicle_plate_category [not null]
  plate_province varchar(100)
  plate_type varchar(50) [not null]
  vehicle_type varchar(50) [not null]
  make varchar(100) [not null]
  model varchar(100) [not null]
  manufacture_year smallint
  chassis_number varchar(100) [not null, unique]
  first_registration_date date [not null]
  last_inspection_date date
  inspection_expiry_date date [not null]
  registered_owner_name_kh varchar(150) [not null]
  registered_owner_name_en varchar(150) [not null]
  registered_owner_phone varchar(20) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  vehicle_class vehicle_class
  inspection_category_id uuid
  classification_verified_at timestamptz
  classification_verified_by uuid

  indexes {
    (plate_province, plate_number) [unique, name: 'uq_vehicles_province_plate_identity']
    plate_number [unique, name: 'uq_vehicles_personalized_plate_number']
    (inspection_category_id, vehicle_class) [name: 'idx_vehicles_inspection_category_class']
  }

  Note: 'uq_vehicles_province_plate_identity is partial where plate_category = PROVINCE; uq_vehicles_personalized_plate_number is partial where plate_category = PERSONALIZED_CAMBODIA. chk_vehicles_plate_province_category enforces the plate-province pairing. chk_vehicles_classification_complete requires vehicle_class, inspection_category_id, classification_verified_at, and classification_verified_by to be either all NULL or all non-NULL.'
}

Table vehicle_classification_history {
  id uuid [pk]
  vehicle_id uuid [not null]
  previous_vehicle_class vehicle_class
  new_vehicle_class vehicle_class [not null]
  previous_inspection_category_id uuid
  new_inspection_category_id uuid [not null]
  changed_by_admin_id uuid [not null]
  reason text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (vehicle_id, created_at, id) [name: 'idx_vehicle_classification_history_vehicle_created']
  }

  Note: 'chk_vehicle_class_history_previous_pair and chk_vehicle_class_history_reason_not_blank apply. fn_guard_vehicle_classification_history and trg_guard_vehicle_classification_history reject UPDATE and DELETE.'
}

Table renewal_applications {
  id uuid [pk]
  reference_number varchar(50) [unique]
  citizen_id uuid [not null]
  vehicle_id uuid [not null]
  status application_status [not null, default: 'DRAFT']
  applicant_snapshot jsonb
  vehicle_snapshot jsonb
  current_correction_reason text
  current_rejection_reason text
  preferred_inspection_station_id uuid
  preferred_inspection_date date
  submitted_at timestamptz
  review_started_at timestamptz
  ready_for_inspection_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  cancelled_by_user_id uuid
  cancellation_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (citizen_id, submitted_at) [name: 'idx_renewal_applications_citizen_submitted_at']
    (vehicle_id, submitted_at) [name: 'idx_renewal_applications_vehicle_submitted_at']
    status [name: 'idx_renewal_applications_status']
    (preferred_inspection_station_id, preferred_inspection_date) [name: 'idx_renewal_applications_preferred_station_date']
  }

  Note: 'reference_number, applicant_snapshot, vehicle_snapshot, and submitted_at are nullable. chk_renewal_applications_current_rejection_reason requires NULL or trimmed length 1-500. chk_renewal_applications_preferred_inspection_selection_pair requires both preferred inspection fields to be NULL or both non-NULL. uq_unfinished_application_per_vehicle is partial for DRAFT, SUBMITTED, UNDER_REVIEW, CORRECTION_REQUIRED, APPOINTMENT_SELECTION_REQUIRED, APPROVED, and REINSPECTION_REQUIRED.'
}

Table renewal_application_status_history {
  id uuid [pk]
  application_id uuid [not null]
  previous_status application_status
  new_status application_status [not null]
  changed_by_user_id uuid
  reason varchar(100)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at, id) [name: 'idx_renewal_application_status_history_application_created']
  }

  Note: 'chk_renewal_application_status_history_transition permits NULL previous_status only when new_status is DRAFT; otherwise previous_status must differ from new_status. public.fn_guard_renewal_application_status_history and trg_guard_renewal_application_status_history_immutable reject UPDATE and DELETE.'
}

Table application_documents {
  id uuid [pk]
  application_id uuid [not null]
  document_type document_type [not null]
  version_number int [not null, default: 1]
  is_current boolean [not null, default: true]
  replaces_document_id uuid
  uploaded_by_user_id uuid [not null]
  storage_key varchar(500) [not null]
  original_file_name varchar(255) [not null]
  mime_type varchar(100) [not null]
  file_size_bytes bigint [not null]
  status document_status [not null, default: 'PENDING']
  reviewed_by_user_id uuid
  reviewed_at timestamptz
  rejection_reason text
  uploaded_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, status) [name: 'idx_application_documents_application_status']
    (application_id, document_type, version_number) [unique, name: 'uq_application_documents_application_document_type_version']
  }

  Note: 'uq_current_document_per_type is partial where is_current = true. Checks: chk_document_version, chk_document_file_size, and chk_application_documents_file_size_max_5mb.'
}

Table inspection_stations {
  id uuid [pk]
  code varchar(30) [not null, unique]
  name_kh varchar(200) [not null]
  name_en varchar(200) [not null]
  province varchar(100) [not null]
  address text [not null]
  phone varchar(20)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table inspection_station_daily_capacities {
  id uuid [pk]
  station_id uuid [not null]
  capacity_date date [not null]
  daily_capacity int [not null]
  reserved_count int [not null, default: 0]
  is_closed boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (station_id, capacity_date) [unique, name: 'uq_inspection_station_daily_capacities_station_date']
  }

  Note: 'Migration 9 checks: chk_inspection_station_daily_capacities_daily_capacity requires daily_capacity > 0; chk_inspection_station_daily_capacities_reserved_count requires reserved_count >= 0 AND reserved_count <= daily_capacity.'
}

Table appointment_slots {
  id uuid [pk]
  station_id uuid [not null]
  slot_date date [not null]
  start_time time [not null]
  end_time time [not null]
  capacity smallint [not null, default: 1]
  status appointment_slot_status [not null, default: 'OPEN']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (station_id, slot_date, start_time, end_time) [unique, name: 'uq_appointment_slots_station_date_start_end']
    (station_id, slot_date, status) [name: 'idx_appointment_slots_station_date_status']
  }

  Note: 'Checks: chk_appointment_slot_capacity and chk_appointment_slot_time.'
}

Table appointments {
  id uuid [pk]
  application_id uuid [not null]
  slot_id uuid
  daily_capacity_id uuid
  status appointment_status [not null, default: 'SCHEDULED']
  booked_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  cancelled_at timestamptz
  cancelled_by_user_id uuid
  cancellation_reason text
  no_show_marked_at timestamptz
  no_show_marked_by_user_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, application_id) [unique, name: 'uq_appointments_id_application']
    (application_id, status) [name: 'idx_appointments_application_status']
    (slot_id, status) [name: 'idx_appointments_slot_status']
    (daily_capacity_id, status) [name: 'idx_appointments_daily_capacity_status']
  }

  Note: 'chk_appointments_slot_or_daily_capacity is an XOR: slot_id non-NULL with daily_capacity_id NULL, or slot_id NULL with daily_capacity_id non-NULL. uq_scheduled_appointment_per_application is partial where status = SCHEDULED.'
}

Table inspections {
  id uuid [pk]
  application_id uuid [not null]
  appointment_id uuid [not null, unique]
  attempt_number smallint [not null]
  status inspection_status [not null, default: 'PENDING']
  result inspection_result
  recorded_by_user_id uuid
  started_at timestamptz
  completed_at timestamptz
  failure_reason text
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, attempt_number) [unique, name: 'uq_inspections_application_attempt']
    (application_id, created_at) [name: 'idx_inspections_application_created']
    status [name: 'idx_inspections_status']
    result [name: 'idx_inspections_result']
  }

  Note: 'chk_inspections_attempt_number permits only 1 or 2. chk_inspections_state_consistency and chk_inspections_result_failure_reason enforce pending/completed and PASS/FAIL fields. fn_guard_completed_inspection_immutable and trg_guard_completed_inspection_immutable reject UPDATE and DELETE after COMPLETED. Reinspection deadline and NO_SHOW count are derived, not persisted.'
}

Table payments {
  id uuid [pk]
  application_id uuid [not null, unique]
  invoice_number varchar(50) [not null, unique]
  receipt_number varchar(50) [unique]
  method payment_method [not null]
  status payment_status [not null, default: 'PENDING']
  base_amount numeric(12,2) [not null]
  inspection_fee_khr numeric(12,2) [not null]
  service_fee_khr numeric(12,2) [not null]
  late_fee numeric(12,2) [not null, default: 0]
  total_amount numeric(12,2) [not null]
  currency char(3) [not null, default: 'KHR']
  payment_reference varchar(100)
  provider_name varchar(100)
  provider_transaction_id varchar(150)
  confirmed_by_user_id uuid
  confirmed_at timestamptz
  failed_at timestamptz
  failure_reason text
  rejected_at timestamptz
  rejected_by_user_id uuid
  rejection_reason text
  invoice_issued_at timestamptz [not null, default: `now()`]
  invoice_file_key varchar(500)
  receipt_file_key varchar(500)
  previous_inspection_expiry_date date [not null]
  late_days integer [not null]
  inspection_sheet_file_key varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    method [name: 'idx_payments_method']
    status [name: 'idx_payments_status']
    (provider_name, provider_transaction_id) [unique, name: 'uq_provider_transaction']
  }

  Note: 'uq_provider_transaction is partial where provider_transaction_id IS NOT NULL. chk_payment_amounts requires non-negative components and total_amount = base_amount + late_fee. chk_payments_provider_name_required requires provider_name when provider_transaction_id is non-NULL. chk_payments_late_days_nonnegative requires late_days >= 0. chk_payments_inspection_fee_nonnegative requires inspection_fee_khr >= 0. chk_payments_service_fee_nonnegative requires service_fee_khr >= 0. chk_payments_base_amount_fee_components requires base_amount = inspection_fee_khr + service_fee_khr.'
}

Table payment_status_history {
  id uuid [pk]
  payment_id uuid [not null]
  from_status payment_status [not null]
  to_status payment_status [not null]
  changed_by_user_id uuid
  reason text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (payment_id, created_at) [name: 'idx_payment_status_history_payment_created']
    changed_by_user_id [name: 'idx_payment_status_history_changed_by_user']
  }

  Note: 'chk_payment_status_history_status_transition requires from_status <> to_status.'
}

Table stickers {
  id uuid [pk]
  application_id uuid [not null, unique]
  inspection_id uuid [not null, unique]
  sticker_number varchar(100) [not null, unique]
  issued_at timestamptz [not null]
  issued_by_user_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    issued_at [name: 'idx_stickers_issued_at']
  }

  Note: 'chk_stickers_sticker_number_trimmed_nonempty requires sticker_number to be non-empty and already trimmed.'
}

Table notifications {
  id uuid [pk]
  recipient_user_id uuid [not null]
  application_id uuid
  type notification_type [not null]
  channel notification_channel [not null, default: 'IN_APP']
  delivery_status notification_delivery_status [not null, default: 'SENT']
  title varchar(255) [not null]
  message text [not null]
  data jsonb
  created_by_user_id uuid
  sent_at timestamptz
  failed_at timestamptz
  failure_reason text
  is_read boolean [not null, default: false]
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at) [name: 'idx_notifications_application_created']
    (recipient_user_id, is_read, created_at) [name: 'idx_notifications_recipient_read_created']
  }
}

Table application_timeline_events {
  id uuid [pk]
  application_id uuid [not null]
  event_type timeline_event_type [not null]
  title varchar(255) [not null]
  message text
  actor_user_id uuid
  visible_to_citizen boolean [not null, default: true]
  metadata jsonb
  occurred_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, occurred_at) [name: 'idx_timeline_application_occurred']
    (application_id, visible_to_citizen, occurred_at) [name: 'idx_timeline_application_visible_occurred']
  }
}

Table audit_logs {
  id uuid [pk]
  actor_type audit_actor_type [not null]
  actor_user_id uuid
  application_id uuid
  action varchar(100) [not null]
  entity_type varchar(100) [not null]
  entity_id uuid
  description text
  old_values jsonb
  new_values jsonb
  ip_address inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (actor_user_id, created_at) [name: 'idx_audit_logs_actor_created']
    (entity_type, entity_id, created_at) [name: 'idx_audit_logs_entity_created']
    (application_id, created_at) [name: 'idx_audit_logs_application_created']
  }
}

Ref: citizen_profiles.user_id - users.id [delete: restrict, update: no action]
Ref: verification_codes.user_id > users.id [delete: set null, update: no action]
Ref: refresh_sessions.user_id > users.id [delete: cascade, update: no action]
Ref: vehicles.linked_citizen_id > users.id [delete: set null, update: no action]
Ref: vehicles.(inspection_category_id, vehicle_class) > inspection_vehicle_categories.(id, vehicle_class) [delete: restrict, update: restrict]
Ref: vehicles.classification_verified_by > users.id [delete: restrict, update: restrict]
Ref: vehicle_classification_history.vehicle_id > vehicles.id [delete: restrict, update: restrict]
Ref: vehicle_classification_history.(previous_inspection_category_id, previous_vehicle_class) > inspection_vehicle_categories.(id, vehicle_class) [delete: restrict, update: restrict]
Ref: vehicle_classification_history.(new_inspection_category_id, new_vehicle_class) > inspection_vehicle_categories.(id, vehicle_class) [delete: restrict, update: restrict]
Ref: vehicle_classification_history.changed_by_admin_id > users.id [delete: restrict, update: restrict]
Ref: renewal_applications.citizen_id > users.id [delete: restrict, update: no action]
Ref: renewal_applications.vehicle_id > vehicles.id [delete: restrict, update: no action]
Ref: renewal_applications.cancelled_by_user_id > users.id [delete: set null, update: no action]
Ref: renewal_applications.preferred_inspection_station_id > inspection_stations.id [delete: restrict, update: restrict]
Ref: renewal_application_status_history.application_id > renewal_applications.id [delete: restrict, update: restrict]
Ref: renewal_application_status_history.changed_by_user_id > users.id [delete: restrict, update: restrict]
Ref: application_documents.application_id > renewal_applications.id [delete: restrict, update: no action]
Ref: application_documents.uploaded_by_user_id > users.id [delete: restrict, update: no action]
Ref: application_documents.reviewed_by_user_id > users.id [delete: set null, update: no action]
Ref: application_documents.replaces_document_id > application_documents.id [delete: restrict, update: no action]
Ref: inspection_station_daily_capacities.station_id > inspection_stations.id [delete: restrict, update: restrict]
Ref: appointment_slots.station_id > inspection_stations.id [delete: restrict, update: no action]
